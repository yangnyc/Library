# Copy to .env and fill in. Never commit .env or put real secrets in this file.

APP_NAME="Jewish Library"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://library.example.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# --- Branding (all replaceable) ------------------------------------------
LIBRARY_NAME="${APP_NAME}"
LIBRARY_SHORT_NAME="Jewish Library"
LIBRARY_CONTACT_EMAIL=
LIBRARY_RIGHTS_EMAIL=
LIBRARY_THEME_COLOR="#6d1a2d"
# Interface languages; each needs lang/<code>/ui.php and reader.php
LIBRARY_UI_LOCALES=en,ru,he

# --- Database (MySQL 8 / MariaDB 10.6+ with utf8mb4) ---------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Sessions, cache, queue: database/file only, no extra services -------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database
# Must stay above the import job timeout (40 s). See DEPLOYMENT_CPANEL.md.
DB_QUEUE_RETRY_AFTER=90
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail ----------------------------------------------------------------
# Password reset and email verification stay switched off until SMTP works
# and LIBRARY_MAIL_ENABLED=true.
LIBRARY_MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Library behaviour ---------------------------------------------------
LIBRARY_ADMIN_REQUIRE_2FA=true
LIBRARY_MAX_UPLOAD_MB=64
LIBRARY_ZIP_MAX_ENTRIES=5000
LIBRARY_ZIP_MAX_EXPANDED_MB=512
LIBRARY_ZIP_MAX_RATIO=200
LIBRARY_DOWNLOADS_PER_MINUTE=30
LIBRARY_WORKER_MAX_TIME=50
# Optional credential-free host for book content, e.g. https://content.example.org
LIBRARY_CONTENT_ORIGIN=
# Only needed for the split public_html layout (see DEPLOYMENT_CPANEL.md)
# LIBRARY_STORAGE_PATH=
# LIBRARY_COVERS_PATH=

VITE_APP_NAME="${APP_NAME}"
